# -*- mode: ruby -*-
# vi: set ft=ruby :

# jinja2: trim_blocks: True, lstrip_blocks: False

{% if vagrantfile_minimum_vagrant_version is defined %}
Vagrant.require_version '>={{ vagrantfile_minimum_vagrant_version }}'
{% endif %}

Vagrant.configure('2') do |config|
{% if vagrantfile_sync_directories | default([]) | length == 0 %}
  config.vm.synced_folder '.', '/vagrant', disabled: true
{% else %}
{% for directory in vagrantfile_sync_directories %}
  config.vm.synced_folder '{{ directory.src }}', '{{ directory.dest }}'
{% endfor %}
{% endif %}

{% for vm in vagrantfile_virtual_machines %}
  config.vm.define '{{ vm.label }}' do |{{ vm.label }}|
    {{ vm.label }}.vm.box = '{{ vm.box }}'
{% if vm.hostname is defined %}
    {{ vm.label }}.vm.hostname = '{{ vm.hostname }}'
{% endif %}

{% if vm.network is defined and vm.network.forwarded_ports is defined %}
{% for forwarded_port in vm.network.forwarded_ports %}
    {{ vm.label }}.vm.network "forwarded_port", guest: {{ forwarded_port.guest }}, host: {{ forwarded_port.host }}
{% endfor %}
{% endif %}

{% if vm.network is defined and vm.network.private_network is defined %}
    {{ vm.label }}.vm.network "private_network", type: "{{ vm.network.private_network.type }}"
{% endif %}
{% if vm.provider.virtualbox is defined %}
    {{ vm.label }}.vm.provider 'virtualbox' do |prov|
      prov.memory = '{{ vm.provider.memory | default(2048) }}'
      prov.cpus = '{{ vm.provider.cpus | default(2) }}'
{% if vm.provider.name is defined %}
      prov.name = '{{ vm.name }}'
{% endif %}
    end
{% else %}
    {{ vm.label }}.vm.provider 'libvirt' do |prov|
      prov.memory = '{{ vm.memory | default(2048) }}'
      prov.cpus = '{{ vm.cpus | default(2) }}'
{% if vm.provider.libvirt.video_type is defined %}
      prov.video_type = '{{ vm.provider.libvirt.video_type }}'
{% endif %}
    end
{% endif %}

{% for file in vm.provision.files | default([]) %}
    {{ vm.label }}.vm.provision "file", source: "{{ file.src }}", destination: "{{ file.dest }}"
{% endfor %}

{% if vm.provision.shell is defined %}
    $shell_script = <<~SCRIPT
    {{ vm.provision.shell | indent(4) }}
    SCRIPT
{%- endif %}

{% if vm.provision.ansible is defined %}
    {{ vm.label }}.vm.provision 'ansible' do |ansible|
      ansible.playbook = '{{ vm.provision.ansible.playbook }}'
      ansible.groups = {
{% for group in vm.provision.ansible.groups | default(['all']) %}
        '{{ group }}' => ['{{ vm.label }}']{% if not loop.last %},{% endif %}
{% endfor %}

      }
    end
{% endif %}
  end
{% endfor %}
end
